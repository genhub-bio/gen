{
    "name": "gen-wasm-demo",
    "version": "1.0.0",
    "description": "Standalone in-browser terminal for testing the gen wasm32-unknown-emscripten build, built on @jupyterlite/cockle",
    "license": "Apache-2.0",
    "private": true,
    "scripts": {
        "postinstall": "patch-package",
        "build": "rspack build",
        "postbuild": "npm run postbuild:copy-assets && npm run postbuild:prepare-wasm",
        "postbuild:copy-assets": "copyfiles -u 1 assets/* dist/ && copyfiles -u 1 gen-wasm/* dist/gen-wasm/",
        "postbuild:prepare-wasm": "node node_modules/@jupyterlite/cockle/lib/tools/prepare_wasm.js --copy dist/",
        "serve": "static-handler --coi --port 4501 dist/"
    },
    "devDependencies": {
        "@jupyterlite/cockle": "^1.7.0",
        "@rspack/cli": "^2.1.3",
        "@rspack/core": "^2.1.3",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "copyfiles": "^2.4.1",
        "css-loader": "^7.1.4",
        "patch-package": "^8.0.1",
        "static-handler": "^0.5.3",
        "style-loader": "^4.0.0",
        "ts-loader": "^9.6.2",
        "typescript": "^5.5.4"
    }
}
