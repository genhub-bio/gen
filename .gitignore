.DS_Store

# Gen tracking dir
.gen/

# IDE
.vscode/*
flamegraph.svg
rust-analyzer.json

# Terminal recording via VHS
*.tape

# R bindings (library crate — lock not committed)
gen-r/src/rust/Cargo.lock

# Python bindings
**/__pycache__/
gen-python/python/gen/*.so
**/node_modules/
gen-python/python/gen/static/jupyter_widget.js.map

# Cap'n proto generated files
**/generated/*capnp.rs

