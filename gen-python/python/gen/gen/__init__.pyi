        filename : str
            Output file path.
        node_max : int, optional
            Maximum node sequence length before splitting.
        """
    def export_genbank(self, filename: builtins.str) -> None:
        r"""
        Export all sequence graphs in this sequence graph's sample to GenBank.

        Parameters
        filename : str
            Output file path.
