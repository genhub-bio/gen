    def translate_annotation(
        self,
        region: str | Annotation | None = None,
        output_collection: typing.Optional[builtins.str] = None,
        name: typing.Optional[builtins.str] = None,
        strand: typing.Optional[builtins.str] = None,
        frame: builtins.int = 0,
        codon_table: builtins.int = 1,
        start: typing.Optional[builtins.int] = None,
    ) -> SequenceGraph:
