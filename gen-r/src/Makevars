TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/release
STATLIB = $(LIBDIR)/libgenr.a
PKG_LIBS += $(abspath $(STATLIB))
PKG_CFLAGS = -mmacosx-version-min=11.0

all: $(SHLIB)

.PHONY: $(STATLIB)

$(SHLIB): $(STATLIB)

$(STATLIB):
	MACOSX_DEPLOYMENT_TARGET=11.0 cargo build --release --lib --manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR)

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) $(TARGET_DIR)
