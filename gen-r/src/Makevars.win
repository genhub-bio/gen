RUST_TARGET = x86_64-pc-windows-gnu
TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/$(RUST_TARGET)/release
STATLIB = $(LIBDIR)/libgenr.a
PKG_LIBS += -L$(abspath $(LIBDIR)) -lgenr -lbcrypt -lntdll

all: $(SHLIB)

.PHONY: $(STATLIB)

$(SHLIB): $(STATLIB)

$(STATLIB):
	cargo build --release --lib --target $(RUST_TARGET) --manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR)
	dir .\rust\target\release
	dir .\rust\target\release\deps
	dir $(LIBDIR)

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) $(TARGET_DIR)
